# Copy this file to /etc/erizon/erizon.env on the server and restrict it to
# the service user (for example: chmod 640 /etc/erizon/erizon.env).
DJANGO_SETTINGS_MODULE=amazon.production_settings
DJANGO_SECRET_KEY=replace-with-a-new-long-random-secret
DJANGO_ALLOWED_HOSTS=89.168.60.56

# Leave these false while accessing the isolated service at http://IP:8001.
# Set all three to true and use an https:// hostname after TLS is configured.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

# Example after assigning a domain and TLS:
# DJANGO_ALLOWED_HOSTS=shop.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
